{
  "name": "hoyo_gacha",
  "displayName": "HoYo.Gacha",
  "version": "1.3.0",
  "description": "An unofficial tool for managing and analyzing your miHoYo gacha records",
  "author": "lgou2w <lgou2w@hotmail.com>",
  "homepage": "https://github.com/lgou2w/HoYo.Gacha#readme",
  "repository": "https://github.com/lgou2w/HoYo.Gacha",
  "bugs": "https://github.com/lgou2w/HoYo.Gacha/issues",
  "license": "MIT OR Apache-2.0",
  "private": "true",
  "type": "module",
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5",
  "engines": {
    "node": "^22 || >=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "clean": "pnpm app:clean && pnpm tauri:clean",
    "dev": "concurrently --raw --kill-others \"pnpm:app:dev\" \"pnpm:tauri:dev\"",
    "build": "pnpm app:build && pnpm tauri:build",
    "lint": "pnpm app:lint && pnpm tauri:lint",
    "test": "pnpm app:test && pnpm tauri:test",
    "app:clean": "rimraf dist",
    "app:dev": "cross-env NODE_ENV=development vite",
    "app:build": "cross-env NODE_ENV=production tsc && vite build",
    "app:lint": "eslint --max-warnings 0 --report-unused-disable-directives .",
    "app:test": "vitest run --passWithNoTests",
    "tauri:clean": "cargo clean",
    "tauri:dev": "cross-env RUST_BACKTRACE=1 RUST_LOG=trace tauri dev",
    "tauri:build": "tauri build",
    "tauri:lint": "cargo check",
    "tauri:test": "cargo test"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@fluentui/react-motion-components-preview": "^0.15.9",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tauri-apps/api": "^2.12.3",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.3",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@griffel/vite-plugin": "^1.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
