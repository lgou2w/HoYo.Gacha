{
  "name": "hoyo_gacha",
  "displayName": "HoYo.Gacha",
  "version": "1.3.0",
  "description": "An unofficial tool for managing and analyzing your miHoYo gacha records",
  "author": "lgou2w <lgou2w@hotmail.com>",
  "homepage": "https://github.com/lgou2w/HoYo.Gacha#readme",
  "repository": "https://github.com/lgou2w/HoYo.Gacha",
  "bugs": "https://github.com/lgou2w/HoYo.Gacha/issues",
  "license": "MIT OR Apache-2.0",
  "private": "true",
  "type": "module",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "^22 || >=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "clean": "pnpm app:clean && pnpm tauri:clean",
    "dev": "concurrently --raw --kill-others \"pnpm:app:dev\" \"pnpm:tauri:dev\"",
    "build": "pnpm app:build && pnpm tauri:build",
    "lint": "pnpm app:lint && pnpm tauri:lint",
    "test": "pnpm app:test && pnpm tauri:test",
    "app:clean": "rimraf dist",
    "app:dev": "cross-env NODE_ENV=development vite",
    "app:build": "cross-env NODE_ENV=production tsc && vite build",
    "app:lint": "eslint --max-warnings 0 --report-unused-disable-directives .",
    "app:test": "vitest run --mode=test --passWithNoTests --reporter=tree",
    "tauri:clean": "cargo clean",
    "tauri:dev": "cross-env RUST_BACKTRACE=1 RUST_LOG=trace tauri dev",
    "tauri:build": "tauri build",
    "tauri:lint": "cargo check",
    "tauri:test": "cargo test"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@fluentui/react-components": "^9.75.0",
    "@fluentui/react-icons": "^2.0.344",
    "@fluentui/react-motion-components-preview": "^0.15.10",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.5.11",
    "immer": "^11.2.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-virtuoso": "^4.18.19"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@griffel/tag-processor": "^1.0.16",
    "@griffel/vite-plugin": "^0.1.16",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "glob": "^13.0.6",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
